# Common portable exports for bash and zsh.
# Keep this file conservative: do not assume optional tools exist.

# Homebrew on Apple Silicon macOS. Only load it when brew exists there.
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# User-local binary directories.
if [ -d "$HOME/bin" ]; then
  case ":$PATH:" in
    *":$HOME/bin:"*) ;;
    *) PATH="$HOME/bin:$PATH" ;;
  esac
fi

if [ -d "$HOME/.local/bin" ]; then
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) PATH="$HOME/.local/bin:$PATH" ;;
  esac
fi

export PATH

# Defaults that should exist almost everywhere.
export EDITOR="${EDITOR:-vim}"
export PAGER="less"
