# Optional tool aliases.
# Aliases are defined only when the related binary exists.

if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons'
  alias ll='eza -lah --icons --group-directories-first'
  alias lt='eza --tree --level=2 --icons'
fi

if command -v bat >/dev/null 2>&1; then
  alias cat='bat'
elif command -v batcat >/dev/null 2>&1; then
  alias cat='batcat'
fi

# zoxide is initialized from the shell-specific rc file.
# fzf may enable shell integrations when installed, depending on future setup.
